# Azure Translator のエンドポイント（講座共通の Foundry リソースのカスタムドメイン。README 手順3で取得）
TRANSLATOR_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/

# キー認証フォールバック時のみ（キーレス運用なら空のままでOK）
TRANSLATOR_KEY=
TRANSLATOR_REGION=japaneast

# LLM翻訳（トーン制御）用：Foundry にデプロイした生成モデルのデプロイ名
LLM_DEPLOYMENT=gpt-5.4

# ▼ insufficient quota でデプロイできない場合
#    最下位のクォータティア（Free Tier / Tier 0）には gpt-5.4 系がありません。
#    LLM 翻訳に使えるモデルは Translator が決めており、最下位ティアで使える gpt-5-mini は
#    「not supported」の 400 になります（講座の検証 2026-10-23。gpt-5.1 と gpt-5.4 は動作）。
#    その場合は LLM_DEPLOYMENT= を空にすると、① NMT 翻訳だけ実行し、② LLM 翻訳はスキップします。
#    詳細は FAQ.md を参照。
# LLM_DEPLOYMENT=

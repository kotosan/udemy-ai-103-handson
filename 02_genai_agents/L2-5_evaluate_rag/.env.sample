# 採点役（judge）を呼ぶエンドポイント。README 手順3で表示した https://<Foundry リソース名>.openai.azure.com/ を貼る
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/

# 採点役のデプロイ名（デプロイの name。モデルのカタログ名ではない）。
JUDGE_DEPLOYMENT=gpt-5.1
# gpt-5.1 は推論モデルなので、評価器に is_reasoning_model=True を渡す（false にすると 400 になる。README 手順9）。
JUDGE_IS_REASONING_MODEL=true

# ▼ 最下位のクォータティア（Free Tier / Tier 0）で gpt-5.1 をデプロイできない場合は、gpt-5-mini でも採点できます
#    （推論モデルなので JUDGE_IS_REASONING_MODEL=true のまま）。詳細はリポジトリ直下の FAQ.md を参照。
# JUDGE_DEPLOYMENT=gpt-5-mini

AZURE_OPENAI_API_VERSION=2024-10-21

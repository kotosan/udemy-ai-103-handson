FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# デプロイ名を入れる（モデルのカタログ名ではない）。README 手順2の一覧の Name 列
FOUNDRY_MODEL=gpt-5.4

# ▼ 最下位のクォータティア（Free Tier / Tier 0）で gpt-5.4 をデプロイできない場合は、gpt-5-mini でも動きます
#    （講座の試走では調整ラウンドは同じ3回、時間は約2倍でした）。詳細はリポジトリ直下の FAQ.md を参照。
# FOUNDRY_MODEL=gpt-5-mini
